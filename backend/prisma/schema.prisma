generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  Admin
  DevOps
  Viewer
}

enum ServerStatus {
  Active
  Stopped
  Provisioning
  Error
}

enum AlertSeverity {
  Info
  Warning
  Critical
}

model User {
  id       String  @id @default(uuid()) @db.Uuid
  email    String  @unique
  password String
  role     Role
  teamId   String? @db.Uuid
  team     Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
}

model Team {
  id       String    @id @default(uuid()) @db.Uuid
  name     String
  users    User[]
  projects Project[]
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  environment String
  teamId      String   @db.Uuid
  team        Team     @relation(fields: [teamId], references: [id])
  servers     Server[]
}

model Server {
  id           String        @id @default(uuid()) @db.Uuid
  provider     String
  region       String
  cpu          Int
  ram          Int
  storage      Int
  ip           String
  status       ServerStatus
  projectId    String        @db.Uuid
  project      Project       @relation(fields: [projectId], references: [id])
  applications Application[]
  metrics      Metric[]
  alerts       Alert[]
}

model Application {
  id       String @id @default(uuid()) @db.Uuid
  name     String
  version  String
  serverId String @db.Uuid
  server   Server @relation(fields: [serverId], references: [id])
}

model Metric {
  id       String @id @default(uuid()) @db.Uuid
  cpuUsage Float
  ramUsage Float
  serverId String @db.Uuid
  server   Server @relation(fields: [serverId], references: [id])
}

model Alert {
  id        String        @id @default(uuid()) @db.Uuid
  severity  AlertSeverity
  threshold Float
  serverId  String        @db.Uuid
  server    Server        @relation(fields: [serverId], references: [id])
  incidents Incident[]
}

model Incident {
  id      String @id @default(uuid()) @db.Uuid
  message String
  alertId String @db.Uuid
  alert   Alert  @relation(fields: [alertId], references: [id])
}